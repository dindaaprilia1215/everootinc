---
import '../styles/global.css';
import {
  type Lang,
  getSiteData,
  localizePath,
  stripLocalePrefix,
  switchLangPath,
  uiStrings
} from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  includeLeaflet?: boolean;
  lang?: Lang;
}

const {
  title,
  description,
  currentPath = Astro.url.pathname,
  includeLeaflet = false,
  lang = 'id'
} = Astro.props;

const { companyProfile } = getSiteData(lang);
const t = uiStrings[lang];
const resolvedDescription = description ?? companyProfile.shortIntro;

const canonicalSubpath = stripLocalePrefix(currentPath);
const navItems = t.navItems.map((item) => ({
  basePath: item.path,
  href: localizePath(item.path, lang),
  label: item.label
}));

const idSwitchHref = switchLangPath(currentPath, 'id');
const enSwitchHref = switchLangPath(currentPath, 'en');
const rfqHref = localizePath('/contact#rfq-form', lang);
const homeHref = localizePath('/', lang);
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Everoot Inc.</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="alternate" hreflang="id" href={idSwitchHref} />
    <link rel="alternate" hreflang="en" href={enSwitchHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {includeLeaflet && (
      <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin=""
      />
    )}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('everoot-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t.skipLink}</a>

    <header class="site-header">
      <div class="container header-inner">
        <nav class="savee-nav" aria-label={t.navAriaLabel}>
          <a href={homeHref} class="brand-link" aria-label={t.brandAriaLabel}>
            <span class="brand-mark" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 32 32" fill="none">
                <rect width="32" height="32" rx="8" fill="currentColor" />
                <path d="M16 7C12 11 10.5 15 10.5 18.5C10.5 21.8137 12.9624 24.5 16 24.5C19.0376 24.5 21.5 21.8137 21.5 18.5C21.5 15 20 11 16 7Z" stroke="var(--accent-fg)" stroke-width="2" stroke-linejoin="round" />
                <path d="M16 13.5V24.5" stroke="var(--accent-fg)" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </span>
            <span class="brand-name">Everoot Inc.</span>
          </a>

          <div class="desktop-nav-links">
            {navItems.map((item) => {
              const isActive =
                item.basePath === '/'
                  ? canonicalSubpath === '/'
                  : canonicalSubpath.startsWith(item.basePath);
              return (
                <a
                  href={item.href}
                  class={`nav-link-item ${isActive ? 'is-active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              );
            })}
          </div>

          <div class="header-actions">
            <div class="lang-switcher" role="group" aria-label={t.header.langSwitchAria}>
              <a
                href={idSwitchHref}
                lang="id"
                hreflang="id"
                class={`lang-pill-option ${lang === 'id' ? 'is-active' : ''}`}
                aria-current={lang === 'id' ? 'true' : undefined}
              >
                ID
              </a>
              <a
                href={enSwitchHref}
                lang="en"
                hreflang="en"
                class={`lang-pill-option ${lang === 'en' ? 'is-active' : ''}`}
                aria-current={lang === 'en' ? 'true' : undefined}
              >
                EN
              </a>
            </div>

            <button
              type="button"
              id="theme-toggle-btn"
              data-theme-toggle
              class="savee-btn savee-btn-secondary-sm theme-toggle-desktop"
              aria-label={t.header.themeAriaLabel}
              aria-pressed="false"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
                <path d="M12 3V5M12 19V21M3 12H5M19 12H21M5.6 5.6L7 7M17 17L18.4 18.4M18.4 5.6L17 7M7 17L5.6 18.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span id="theme-toggle-label" data-theme-label class="theme-label">{t.header.darkModeLabel}</span>
            </button>

            <a href={rfqHref} class="savee-btn savee-btn-primary-sm header-cta-desktop">
              {t.header.rfqShort}
            </a>

            <button
              type="button"
              id="mobile-menu-btn"
              class="savee-btn savee-btn-secondary-sm mobile-menu-trigger"
              aria-expanded="false"
              aria-controls="mobile-nav-sheet"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 7H20M4 12H20M4 17H20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span>{t.header.menuBtn}</span>
            </button>
          </div>
        </nav>

        <div id="mobile-nav-sheet" class="mobile-nav-sheet savee-card-featured" hidden>
          <div class="mobile-nav-list">
            {navItems.map((item) => {
              const isActive =
                item.basePath === '/'
                  ? canonicalSubpath === '/'
                  : canonicalSubpath.startsWith(item.basePath);
              return (
                <a
                  href={item.href}
                  class={`mobile-nav-link ${isActive ? 'is-active' : ''}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span>{item.label}</span>
                  <span aria-hidden="true">→</span>
                </a>
              );
            })}

            <button
              type="button"
              id="mobile-theme-toggle-btn"
              data-theme-toggle
              class="mobile-nav-link mobile-theme-btn"
              aria-label={t.header.themeAriaLabel}
              aria-pressed="false"
            >
              <span class="mobile-theme-copy">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
                  <path d="M12 3V5M12 19V21M3 12H5M19 12H21M5.6 5.6L7 7M17 17L18.4 18.4M18.4 5.6L17 7M7 17L5.6 18.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
                <span data-theme-label>{t.header.darkModeLabel}</span>
              </span>
              <span class="mono-meta" aria-hidden="true">☀ / ☾</span>
            </button>

            <a href={rfqHref} class="savee-btn savee-btn-primary mobile-rfq-btn">
              {t.header.rfqFull}
            </a>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-surface savee-surface-subtle">
          <div class="footer-top">
            <div class="footer-brand-col">
              <span class="mono-meta">{t.footer.eyebrow}</span>
              <h2 class="footer-heading">Everoot Inc.</h2>
              <p class="footer-desc">
                {companyProfile.shortIntro}
              </p>
              <div class="footer-addresses">
                <div class="footer-addr-block">
                  <strong class="addr-title">{t.footer.hqTitle}</strong>
                  <p class="body-md">{t.footer.hqAddress}</p>
                </div>
                <div class="footer-addr-block">
                  <strong class="addr-title">{t.footer.sortingTitle}</strong>
                  <p class="body-md">{t.footer.sortingAddress}</p>
                </div>
              </div>
            </div>

            <div class="footer-links-cols">
              <div>
                <h3 class="footer-subhead">{t.footer.navHeading}</h3>
                <ul class="footer-links">
                  {t.footer.navLinks.map((lnk) => (
                    <li><a href={localizePath(lnk.path, lang)}>{lnk.label}</a></li>
                  ))}
                </ul>
              </div>

              <div>
                <h3 class="footer-subhead">{t.footer.commoditiesHeading}</h3>
                <ul class="footer-links">
                  {t.footer.commoditiesLinks.map((c) => (
                    <li><a href={localizePath(`/products/${c.slug}`, lang)}>{c.label}</a></li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <div class="footer-bottom">
            <span class="body-sm">© 2026 {companyProfile.legalName}. {t.footer.copyrightSuffix}</span>
            <span class="mono-meta">{t.footer.portMeta}</span>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline define:vars={{ darkLabel: t.header.darkModeLabel, lightLabel: t.header.lightModeLabel }}>
      (function () {
        var themeBtns = document.querySelectorAll('[data-theme-toggle]');
        var themeLabels = document.querySelectorAll('[data-theme-label]');
        var mobileBtn = document.getElementById('mobile-menu-btn');
        var mobileSheet = document.getElementById('mobile-nav-sheet');

        function syncThemeUI() {
          var current = document.documentElement.getAttribute('data-theme') || 'light';
          var isDark = current === 'dark';
          themeBtns.forEach(function (btn) {
            btn.setAttribute('aria-pressed', String(isDark));
          });
          themeLabels.forEach(function (lbl) {
            lbl.textContent = isDark ? lightLabel : darkLabel;
          });
        }

        syncThemeUI();

        themeBtns.forEach(function (btn) {
          btn.addEventListener('click', function () {
            var current = document.documentElement.getAttribute('data-theme') || 'light';
            var next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            try {
              localStorage.setItem('everoot-theme', next);
            } catch (e) {}
            syncThemeUI();
          });
        });

        if (mobileBtn && mobileSheet) {
          mobileBtn.addEventListener('click', function () {
            var expanded = mobileBtn.getAttribute('aria-expanded') === 'true';
            var nextState = !expanded;
            mobileBtn.setAttribute('aria-expanded', String(nextState));
            if (nextState) {
              mobileSheet.removeAttribute('hidden');
            } else {
              mobileSheet.setAttribute('hidden', '');
            }
          });

          document.addEventListener('click', function (ev) {
            if (
              mobileBtn.getAttribute('aria-expanded') === 'true' &&
              !mobileSheet.contains(ev.target) &&
              !mobileBtn.contains(ev.target)
            ) {
              mobileBtn.setAttribute('aria-expanded', 'false');
              mobileSheet.setAttribute('hidden', '');
            }
          });

          document.addEventListener('keydown', function (ev) {
            if (ev.key === 'Escape' && mobileBtn.getAttribute('aria-expanded') === 'true') {
              mobileBtn.setAttribute('aria-expanded', 'false');
              mobileSheet.setAttribute('hidden', '');
              mobileBtn.focus();
            }
          });
        }
      })();
    </script>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background-color: var(--canvas);
      }

      .header-inner {
        position: relative;
      }

      .savee-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        height: 64px;
      }

      .brand-link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 44px;
        text-decoration: none;
        color: var(--ink);
        padding: 4px 0;
        border-radius: 8px;
      }

      .brand-mark {
        color: var(--ink);
        display: flex;
        align-items: center;
      }

      .brand-name {
        font-size: 16px;
        font-weight: 500;
        letter-spacing: -0.16px;
        color: var(--ink);
      }

      .desktop-nav-links {
        display: flex;
        align-items: center;
        gap: 20px;
      }

      .nav-link-item {
        position: relative;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        font-size: 15px;
        font-weight: 500;
        line-height: 1.38;
        letter-spacing: -0.16px;
        text-decoration: none;
        white-space: nowrap;
        color: var(--muted);
        transition: color 0.16s ease;
      }

      .nav-link-item:hover {
        color: var(--ink);
      }

      .nav-link-item.is-active {
        color: var(--ink);
      }

      .nav-link-item.is-active::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: 6px;
        height: 2px;
        background-color: var(--ink);
        border-radius: 9999px;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .lang-switcher {
        display: inline-flex;
        align-items: center;
        height: 44px;
        border-radius: var(--rounded-full);
        background-color: var(--subtle);
        overflow: hidden;
        flex-shrink: 0;
      }

      .lang-pill-option {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        height: 44px;
        padding: 0 10px;
        border-radius: var(--rounded-full);
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-decoration: none;
        color: var(--muted);
        transition: background-color 0.16s ease, color 0.16s ease;
      }

      .lang-pill-option:hover {
        color: var(--ink);
      }

      .lang-pill-option.is-active {
        background-color: var(--primary);
        color: var(--accent-fg);
      }

      .mobile-menu-trigger {
        display: none;
      }

      .mobile-nav-sheet {
        position: absolute;
        left: 16px;
        right: 16px;
        top: 68px;
        padding: 16px;
        border-radius: var(--rounded-xs);
        z-index: 120;
      }

      .mobile-nav-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .mobile-nav-link {
        min-height: 46px;
        padding: 10px 16px;
        border-radius: var(--rounded-xs);
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none;
        color: var(--body);
        font-weight: 500;
        background-color: var(--surface-subtle);
      }

      .mobile-nav-link.is-active {
        background-color: var(--primary);
        color: var(--accent-fg);
      }

      .mobile-nav-link.is-active .mono-meta {
        color: var(--accent-fg);
      }

      .mobile-rfq-btn {
        margin-top: 8px;
        width: 100%;
      }

      .site-footer {
        margin-top: 96px;
        padding-bottom: 50px;
      }

      .footer-surface {
        padding: 48px;
        border-radius: var(--rounded-lg);
      }

      .footer-top {
        display: grid;
        grid-template-columns: 1.25fr 1fr;
        gap: 48px;
      }

      .footer-heading {
        font-size: clamp(2rem, 3vw, 3rem);
        margin: 12px 0 16px;
        letter-spacing: -1.2px;
      }

      .footer-desc {
        max-width: 56ch;
        margin-bottom: 28px;
      }

      .footer-addresses {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
      }

      .footer-addr-block {
        padding: 20px;
        border-radius: var(--rounded-xs);
        background-color: var(--canvas);
      }

      .addr-title {
        display: block;
        font-size: 14px;
        font-weight: 500;
        color: var(--ink);
        margin-bottom: 6px;
      }

      .footer-addr-block p {
        margin: 0;
        color: var(--muted);
      }

      .footer-links-cols {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
      }

      .footer-subhead {
        font-size: 16px;
        font-weight: 500;
        color: var(--ink);
        margin-bottom: 14px;
      }

      .footer-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .footer-links a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        font-size: 15px;
        color: var(--body);
        text-decoration: none;
      }

      .footer-links a:hover {
        color: var(--ink);
        text-decoration: underline;
        text-underline-offset: 4px;
      }

      .footer-bottom {
        margin-top: 40px;
        padding-top: 24px;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px;
      }

      .mobile-theme-btn {
        width: 100%;
        border: 0;
        font-family: inherit;
        font-size: inherit;
        cursor: pointer;
        text-align: left;
      }

      .mobile-theme-copy {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }

      @media (max-width: 960px) {
        .desktop-nav-links,
        .theme-toggle-desktop,
        .header-cta-desktop {
          display: none;
        }

        .mobile-menu-trigger {
          display: inline-flex;
        }

        .footer-top {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .savee-nav {
          height: 58px;
          gap: 10px;
        }

        .brand-name {
          font-size: 15px;
          white-space: nowrap;
        }

        .header-actions {
          gap: 8px;
        }

        .lang-pill-option {
          min-width: 38px;
          padding: 0 11px;
          font-size: 12px;
        }

        .mobile-menu-trigger {
          height: 44px;
          padding: 0 14px;
        }

        .mobile-nav-sheet {
          left: 16px;
          right: 16px;
          top: 62px;
          max-height: calc(100dvh - 80px);
          overflow-y: auto;
          box-shadow: var(--shadow-xl);
        }

        .site-footer {
          margin-top: 48px;
          padding-bottom: 32px;
        }

        .footer-surface {
          padding: 24px 18px;
          border-radius: var(--rounded-xs);
        }

        .footer-top {
          gap: 28px;
        }

        .footer-addresses,
        .footer-links-cols {
          grid-template-columns: 1fr;
        }

        .footer-bottom {
          margin-top: 24px;
          padding-top: 16px;
          gap: 6px;
        }
      }
    </style>
  </body>
</html>
