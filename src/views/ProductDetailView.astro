---
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Lang, getSiteData, localizePath, uiStrings } from '../i18n/ui';

interface Props {
  lang?: Lang;
  slug: string;
}

const { lang = 'id', slug } = Astro.props;
const { products } = getSiteData(lang);
const d = uiStrings[lang].productDetail;

const product = products.find((p) => p.slug === slug) ?? products[0];
const relatedProducts = products
  .filter((p) => p.slug !== product.slug)
  .slice(0, 3);
const currentProductPath = localizePath(`/products/${product.slug}`, lang);
---

<BaseLayout
  lang={lang}
  title={`${product.shortName} (HS ${product.hsCode})`}
  description={product.summary}
  currentPath={currentProductPath}
>
  <section class="product-detail-band">
    <div class="container">
      <nav aria-label="Breadcrumb" class="breadcrumb-bar">
        <a href={localizePath('/products', lang)} class="savee-btn savee-btn-secondary-sm">
          {d.backToCatalog}
        </a>
        <span class="mono-meta">
          {currentProductPath} • HS {product.hsCode}
        </span>
      </nav>

      <div class="detail-top-grid">
        <div class="detail-media-col">
          <div class="savee-media-card main-photo-frame">
            <img
              id="detail-main-img"
              src={product.heroImage}
              alt={product.heroImageAlt}
              width="760"
              height="560"
              fetchpriority="high"
              class="detail-main-img"
            />
          </div>
          <p id="detail-main-caption" class="body-sm photo-caption">
            {product.galleryImages[0]?.caption || product.summary}
          </p>

          {product.galleryImages.length > 1 && (
            <div class="thumb-strip" role="group" aria-label={d.thumbAria}>
              {product.galleryImages.map((img, idx) => (
                <button
                  type="button"
                  class={`thumb-btn ${idx === 0 ? 'is-active' : ''}`}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                  data-photo-url={img.url}
                  data-photo-alt={img.alt}
                  data-photo-caption={img.caption}
                >
                  <img
                    src={img.url}
                    alt={img.alt}
                    width="140"
                    height="100"
                    loading="lazy"
                  />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="detail-summary-col">
          <div class="detail-meta-chips">
            <span class="savee-chip">{product.tradeFlow}</span>
            <span class="savee-chip">{product.category}</span>
            <span class="mono-meta">HS {product.hsCode}</span>
          </div>

          <h1 class="display-md detail-title">{product.name}</h1>
          <p class="body-sm detail-origin-line">
            {d.originPrefix} {product.originOrSource}, {product.regency}
          </p>
          <p class="body-xl detail-lead">{product.summary}</p>

          <div class="key-trade-grid">
            <div class="savee-surface-subtle trade-tile">
              <span class="mono-meta">{d.gradeLabel}</span>
              <strong>{product.grade}</strong>
            </div>
            <div class="savee-surface-subtle trade-tile">
              <span class="mono-meta">{d.moqLabel}</span>
              <strong>{product.moq}</strong>
            </div>
            <div class="savee-surface-subtle trade-tile">
              <span class="mono-meta">{d.packagingLabel}</span>
              <strong>{product.packaging}</strong>
            </div>
            <div class="savee-surface-subtle trade-tile">
              <span class="mono-meta">{d.leadTimeLabel}</span>
              <strong>{product.leadTime} ({product.port})</strong>
            </div>
          </div>

          <div class="shipment-estimator savee-surface">
            <div class="savee-field">
              <span class="savee-label" id="ship-mode-label">{d.shipModeLabel}</span>
              <div class="savee-dropdown" id="ship-mode-dropdown">
                <button
                  type="button"
                  class="savee-dropdown-trigger ship-drop-btn"
                  id="ship-mode-btn"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-labelledby="ship-mode-label ship-mode-btn"
                >
                  <span id="ship-mode-selected">{d.shipModes[0].label}</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <ul class="savee-dropdown-menu" id="ship-mode-menu" role="listbox" hidden>
                  {d.shipModes.map((mode, idx) => (
                    <li role="none">
                      <button
                        type="button"
                        role="option"
                        aria-selected={idx === 0 ? 'true' : 'false'}
                        class="savee-dropdown-option"
                        data-ship-label={mode.label}
                        data-ship-note={mode.note}
                      >
                        <span>{mode.label}</span>
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <p id="ship-mode-note" class="body-md ship-note">
              {d.shipModes[0].note}
            </p>
          </div>

          <div class="detail-cta-row">
            <a
              href={localizePath(`/contact?product=${encodeURIComponent(product.shortName)}#rfq-form`, lang)}
              class="savee-btn savee-btn-primary"
            >
              {d.requestContractPrefix} {product.shortName}
            </a>
            <a href={localizePath('/gallery', lang)} class="savee-btn savee-btn-secondary">
              {d.viewGalleryDocs}
            </a>
          </div>
        </div>
      </div>

      <div class="detail-story-grid">
        <article class="story-card savee-surface-subtle">
          <span class="mono-meta">{d.storyEyebrow}</span>
          <h2 class="heading-sm section-block-title">{d.storyHeading}</h2>
          <p class="story-body-text">{product.originStory}</p>

          <div class="partner-badge-box savee-surface">
            <span class="mono-meta">{d.partnerEyebrow}</span>
            <h3 class="heading-sm">{product.partnerName}</h3>
            <p class="body-md">{product.partnerRole}</p>
            <a href={localizePath('/about#ekosistem-mitra', lang)} class="savee-btn savee-btn-secondary-sm partner-link-btn">
              {d.partnerLink}
            </a>
          </div>
        </article>

        <article class="specs-card savee-surface-subtle">
          <span class="mono-meta">{d.specsEyebrow}</span>
          <h2 class="heading-sm section-block-title">{d.specsHeading}</h2>
          <div class="spec-table-wrap">
            <table class="spec-table">
              <thead>
                <tr>
                  <th scope="col">{d.specColParam}</th>
                  <th scope="col">{d.specColValue}</th>
                </tr>
              </thead>
              <tbody>
                {product.specifications.map((spec) => (
                  <tr>
                    <td>{spec.label}</td>
                    <td class="mono-meta spec-val-cell">{spec.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      </div>

      <div class="process-card savee-surface-subtle">
        <div class="process-header">
          <span class="mono-meta">{d.processEyebrow}</span>
          <h2 class="display-md">{d.processHeadingPrefix} ({product.processSteps.length} {d.processHeadingSuffix})</h2>
        </div>

        <div class="process-steps-grid">
          {product.processSteps.map((step) => (
            <div class="process-step-tile">
              <span class="mono-meta">{d.stepLabel} {step.stepNumber}</span>
              <h3 class="heading-sm">{step.title}</h3>
              <p class="body-md">{step.detail}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="related-section">
        <div class="related-header">
          <h2 class="display-md">{d.relatedHeading}</h2>
          <a href={localizePath('/products', lang)} class="savee-btn savee-btn-secondary-sm">{d.viewFullCatalog}</a>
        </div>
        <div class="related-grid">
          {relatedProducts.map((rel) => (
            <article class="related-card">
              <a href={localizePath(`/products/${rel.slug}`, lang)} class="savee-media-card related-media">
                <img
                  src={rel.heroImage}
                  alt={rel.heroImageAlt}
                  width="440"
                  height="300"
                  loading="lazy"
                  class="related-img"
                />
              </a>
              <div class="related-body">
                <span class="mono-meta">HS {rel.hsCode} • {rel.regency}</span>
                <h3 class="heading-sm">{rel.shortName}</h3>
                <p class="body-md">{rel.summary}</p>
                <a href={localizePath(`/products/${rel.slug}`, lang)} class="savee-btn savee-btn-secondary-sm">
                  {d.openDetailPrefix} {rel.shortName}
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var mainImg = document.getElementById('detail-main-img');
    var mainCaption = document.getElementById('detail-main-caption');
    var thumbBtns = document.querySelectorAll('.thumb-btn');

    thumbBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var url = btn.getAttribute('data-photo-url');
        var alt = btn.getAttribute('data-photo-alt');
        var cap = btn.getAttribute('data-photo-caption');
        if (mainImg && url) {
          mainImg.setAttribute('src', url);
          if (alt) mainImg.setAttribute('alt', alt);
        }
        if (mainCaption && cap) {
          mainCaption.textContent = cap;
        }
        thumbBtns.forEach(function (b) {
          var active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
      });
    });

    var shipWrap = document.getElementById('ship-mode-dropdown');
    var shipBtn = document.getElementById('ship-mode-btn');
    var shipMenu = document.getElementById('ship-mode-menu');
    var shipSelected = document.getElementById('ship-mode-selected');
    var shipNote = document.getElementById('ship-mode-note');

    if (shipWrap && shipBtn && shipMenu) {
      var opts = shipMenu.querySelectorAll('.savee-dropdown-option');

      shipBtn.addEventListener('click', function () {
        var expanded = shipBtn.getAttribute('aria-expanded') === 'true';
        shipBtn.setAttribute('aria-expanded', String(!expanded));
        if (expanded) {
          shipMenu.setAttribute('hidden', '');
        } else {
          shipMenu.removeAttribute('hidden');
        }
      });

      opts.forEach(function (opt) {
        opt.addEventListener('click', function () {
          var lbl = opt.getAttribute('data-ship-label');
          var note = opt.getAttribute('data-ship-note');
          opts.forEach(function (o) {
            o.setAttribute('aria-selected', String(o === opt));
          });
          if (shipSelected && lbl) shipSelected.textContent = lbl;
          if (shipNote && note) shipNote.textContent = note;
          shipBtn.setAttribute('aria-expanded', 'false');
          shipMenu.setAttribute('hidden', '');
        });
      });

      document.addEventListener('click', function (ev) {
        if (!shipWrap.contains(ev.target)) {
          shipBtn.setAttribute('aria-expanded', 'false');
          shipMenu.setAttribute('hidden', '');
        }
      });

      document.addEventListener('keydown', function (ev) {
        if (ev.key === 'Escape' && shipBtn.getAttribute('aria-expanded') === 'true') {
          shipBtn.setAttribute('aria-expanded', 'false');
          shipMenu.setAttribute('hidden', '');
          shipBtn.focus();
        }
      });
    }
  })();
</script>
<style>
  .product-detail-band {
    padding: 36px 0 64px;
  }

  .breadcrumb-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .detail-top-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 48px;
    align-items: start;
    margin-bottom: 48px;
  }

  .main-photo-frame {
    margin-bottom: 12px;
  }

  .detail-main-img {
    height: 440px;
  }

  .photo-caption {
    margin-bottom: 16px;
  }

  .thumb-strip {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .thumb-btn {
    padding: 0;
    border-radius: 12px;
    border: 0;
    background: var(--surface);
    overflow: hidden;
    opacity: 0.65;
    transition: opacity 0.16s ease, box-shadow 0.16s ease;
  }

  .thumb-btn.is-active {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--canvas), 0 0 0 4px var(--ink);
  }

  .thumb-btn img {
    width: 104px;
    height: 72px;
    object-fit: cover;
  }

  .detail-meta-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }

  .detail-title {
    margin: 0 0 10px;
  }

  .detail-origin-line {
    margin-bottom: 16px;
  }

  .detail-lead {
    margin-bottom: 24px;
  }

  .key-trade-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 24px;
  }

  .trade-tile {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .trade-tile strong {
    font-weight: 500;
    font-size: 14px;
    color: var(--ink);
  }

  .shipment-estimator {
    padding: 20px;
    margin-bottom: 24px;
  }

  .shipment-estimator .savee-dropdown {
    width: 100%;
  }

  .ship-drop-btn {
    background-color: var(--canvas);
  }

  .ship-note {
    margin: 12px 0 0;
  }

  .detail-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .detail-story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-bottom: 48px;
  }

  .story-card,
  .specs-card {
    padding: 32px;
  }

  .section-block-title {
    margin: 8px 0 14px;
  }

  .story-body-text {
    margin-bottom: 24px;
  }

  .partner-badge-box {
    padding: 22px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .partner-badge-box h3,
  .partner-badge-box p {
    margin: 0;
  }

  .partner-link-btn {
    margin-top: 6px;
    background-color: var(--canvas);
  }

  .spec-table-wrap {
    overflow-x: auto;
  }

  .spec-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 6px;
  }

  .spec-table th,
  .spec-table td {
    text-align: left;
    padding: 12px 16px;
  }

  .spec-table th {
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
  }

  .spec-table tbody tr {
    background-color: var(--canvas);
  }

  .spec-table tbody tr td:first-child {
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
    color: var(--ink);
  }

  .spec-table tbody tr td:last-child {
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
  }

  .spec-val-cell {
    color: var(--ink);
    font-weight: 500;
  }

  .process-card {
    padding: 36px;
    margin-bottom: 64px;
    border-radius: var(--rounded-lg);
  }

  .process-header h2 {
    margin: 8px 0 0;
  }

  .process-steps-grid {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 16px;
  }

  .process-step-tile {
    padding: 22px;
    border-radius: var(--rounded-xs);
    background-color: var(--canvas);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .process-step-tile h3,
  .process-step-tile p {
    margin: 0;
  }

  .related-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 28px;
  }

  .related-header h2 {
    margin: 0;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .related-media {
    aspect-ratio: 4 / 3;
    display: block;
  }

  .related-img {
    height: 100%;
  }

  .related-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    flex: 1;
  }

  .related-body h3,
  .related-body p {
    margin: 0;
  }

  .related-body .savee-btn {
    margin-top: auto;
  }

  @media (max-width: 1024px) {
    .detail-top-grid,
    .detail-story-grid {
      grid-template-columns: 1fr;
    }

    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .product-detail-band {
      padding: 20px 0 40px;
    }

    .breadcrumb-bar {
      margin-bottom: 18px;
      gap: 8px;
    }

    .detail-top-grid {
      gap: 20px;
      margin-bottom: 28px;
    }

    .detail-main-img {
      height: 240px;
    }

    .thumb-strip {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding: 4px 2px;
    }

    .thumb-strip::-webkit-scrollbar {
      display: none;
    }

    .thumb-btn {
      flex: 0 0 auto;
    }

    .thumb-btn img {
      width: 84px;
      height: 60px;
    }

    .key-trade-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 18px;
    }

    .trade-tile {
      padding: 12px 14px;
    }

    .shipment-estimator {
      padding: 16px;
      margin-bottom: 18px;
    }

    .detail-cta-row {
      flex-direction: column;
      gap: 10px;
    }

    .detail-cta-row .savee-btn {
      width: 100%;
    }

    .detail-story-grid {
      gap: 18px;
      margin-bottom: 28px;
    }

    .story-card,
    .specs-card,
    .process-card {
      padding: 20px 16px;
      border-radius: var(--rounded-xs);
    }

    .process-card {
      margin-bottom: 36px;
    }

    .spec-table thead {
      display: none;
    }

    .spec-table,
    .spec-table tbody {
      display: block;
      width: 100%;
    }

    .spec-table tbody tr {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 12px 14px;
      border-radius: 12px;
      margin-bottom: 8px;
    }

    .spec-table tbody td {
      display: block;
      padding: 0;
      border-radius: 0;
    }

    .spec-table tbody td:first-child {
      font-size: 13px;
      color: var(--muted);
    }

    .related-header {
      margin-bottom: 18px;
    }

    .related-header .savee-btn {
      width: 100%;
    }

    .related-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .related-body .savee-btn {
      width: 100%;
    }
  }
</style>

