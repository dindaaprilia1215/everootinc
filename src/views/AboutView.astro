---
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Lang, getSiteData, localizePath, uiStrings } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'id' } = Astro.props;
const {
  companyProfile,
  careerTimeline,
  partnerships,
  companyLocations
} = getSiteData(lang);
const a = uiStrings[lang].about;
const categories = a.categories;
const regencies = a.regencies;
---

<BaseLayout
  lang={lang}
  title={a.pageTitle}
  description={a.pageDesc}
  currentPath={localizePath('/about', lang)}
>
  <section class="about-hero-band">
    <div class="container">
      <div class="about-hero-grid">
        <div class="about-copy-col">
          <span class="mono-meta">{a.heroEyebrow}</span>
          <h1 class="display-lg about-title">{a.heroTitle}</h1>
          <p class="body-xl about-lead">{companyProfile.shortIntro}</p>

          <div class="about-prose">
            <p>{a.storyP1}</p>
            <p>{a.storyP2}</p>
          </div>
        </div>

        <div class="about-visual-col">
          <div class="savee-media-card about-media-frame">
            <img
              src="https://images.unsplash.com/photo-1509316975850-ff9c5deb0cd9?auto=format&fit=crop&w=1000&q=80"
              alt={a.heroImgAlt}
              width="680"
              height="480"
              fetchpriority="high"
              class="about-hero-img"
            />
          </div>

          <div class="savee-surface-subtle vision-box">
            <span class="mono-meta">{a.visionEyebrow}</span>
            <h2 class="heading-sm">{companyProfile.vision}</h2>
            <ul class="mission-list">
              {companyProfile.missions.map((m) => (
                <li class="body-md">{m}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="timeline-band">
    <div class="container">
      <div class="band-intro">
        <span class="mono-meta">{a.timelineEyebrow}</span>
        <h2 class="display-md">{a.timelineHeading}</h2>
        <p class="body-xl">{a.timelineLead}</p>
      </div>

      <div class="timeline-list">
        {careerTimeline.map((step, index) => (
          <article class="timeline-row savee-surface-subtle">
            <div class="timeline-year-col">
              <span class="mono-meta">0{index + 1}</span>
              <span class="timeline-year">{step.year}</span>
              <span class="mono-meta">{step.location}</span>
            </div>

            <div class="timeline-body-col">
              <div class="timeline-meta-row">
                <span class="savee-chip">{step.phase}</span>
                <span class="mono-meta">{step.highlightTag}</span>
              </div>
              <h3 class="heading-sm">{step.title}</h3>
              <p>{step.summary}</p>
              <p class="body-md">{step.operationalDetail}</p>
            </div>

            <div class="timeline-impact-col savee-surface">
              <span class="mono-meta">{a.milestoneTag}</span>
              <p class="heading-xs">{step.keyAchievement}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="partners-band" id="ekosistem-mitra">
    <div class="container">
      <div class="band-intro">
        <span class="mono-meta">{a.partnersEyebrow}</span>
        <h2 class="display-md">{a.partnersHeading}</h2>
        <p class="body-xl">{a.partnersLead}</p>
      </div>

      <div class="partner-filter-deck savee-surface-subtle">
        <div class="filter-row-top">
          <div class="savee-segmented" role="group" aria-label={a.filterCatAria}>
            {categories.map((cat, idx) => (
              <button
                type="button"
                class={`savee-segment-btn ${idx === 0 ? 'is-active' : ''}`}
                aria-pressed={idx === 0 ? 'true' : 'false'}
                data-partner-cat={cat}
              >
                {cat}
              </button>
            ))}
          </div>

          <div class="savee-dropdown" id="partner-regency-dropdown">
            <button
              type="button"
              class="savee-dropdown-trigger"
              id="regency-drop-btn"
              aria-haspopup="listbox"
              aria-expanded="false"
            >
              <span id="regency-drop-label">{a.regionPrefix} {a.allRegionValue}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <ul
              class="savee-dropdown-menu"
              id="regency-drop-menu"
              role="listbox"
              aria-labelledby="regency-drop-btn"
              hidden
            >
              {regencies.map((reg, idx) => (
                <li role="none">
                  <button
                    type="button"
                    role="option"
                    aria-selected={idx === 0 ? 'true' : 'false'}
                    class="savee-dropdown-option"
                    data-regency-val={reg}
                  >
                    <span>{reg}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="filter-row-bottom">
          <div class="savee-field">
            <label for="partner-search-input" class="savee-label">{a.searchLabel}</label>
            <input
              type="search"
              id="partner-search-input"
              class="savee-input search-on-surface"
              placeholder={a.searchPlaceholder}
            />
          </div>
          <span id="partner-count-status" class="mono-meta" role="status" aria-live="polite">
            {a.countTemplate.replace('{n}', String(partnerships.length))}
          </span>
        </div>
      </div>

      <div id="partner-empty-state" class="ui-state-box" role="status" aria-live="polite" hidden>
        <h3 class="heading-sm">{a.emptyTitle}</h3>
        <p>{a.emptyDesc(partnerships.length)}</p>
        <button type="button" id="partner-reset-btn" class="savee-btn savee-btn-secondary-sm">
          {a.resetBtn}
        </button>
      </div>

      <div id="partner-cards-grid" class="partner-cards-grid">
        {partnerships.map((p) => (
          <article
            class="partner-card savee-surface-subtle"
            data-category={p.category}
            data-location={p.regencyOrCity}
            data-search={`${p.name} ${p.regencyOrCity} ${p.commodities.join(' ')} ${p.story}`.toLowerCase()}
          >
            <div class="partner-card-top">
              <span class="savee-chip">{p.category}</span>
              <span class="mono-meta">{a.sincePrefix} {p.sinceYear}</span>
            </div>

            <div>
              <h3 class="heading-sm">{p.name}</h3>
              <p class="body-sm">{p.regencyOrCity} • {p.memberCountLabel}</p>
            </div>

            <p class="body-md">{p.story}</p>

            <div class="partner-model-block savee-surface">
              <span class="mono-meta">{a.schemeHeading}</span>
              <p class="body-md">{p.collaborationModel}</p>
            </div>

            <div class="partner-commodities">
              {p.commodities.map((c) => (
                <span class="commodity-tag mono-meta">{c}</span>
              ))}
            </div>

            <span class="mono-meta">{a.verifyPrefix} {p.verificationNote}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="facilities-band">
    <div class="container">
      <div class="facilities-surface savee-surface">
        <div class="facilities-header">
          <div>
            <span class="mono-meta">{a.infraEyebrow}</span>
            <h2 class="display-md">{a.infraHeading}</h2>
          </div>
          <a href={localizePath('/contact#lokasi-peta', lang)} class="savee-btn savee-btn-primary">
            {a.openInteractiveMap}
          </a>
        </div>

        <div class="facilities-grid">
          {companyLocations.map((loc) => (
            <div class="facility-card">
              <span class="mono-meta">{loc.city}</span>
              <h3 class="heading-sm">{loc.name}</h3>
              <p class="body-md facility-role">{loc.role}</p>
              <p class="body-sm">{loc.address}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script
  is:inline
  define:vars={{
    allCatValue: a.allCatValue,
    allRegionValue: a.allRegionValue,
    regionPrefix: a.regionPrefix,
    regionIntlValue: a.regionIntlValue,
    regionIntlTerms: a.regionIntlTerms,
    countTemplate: a.countTemplate
  }}
>
  (function () {
    var activeCat = allCatValue;
    var activeRegency = allRegionValue;
    var searchQuery = '';

    var catBtns = document.querySelectorAll('[data-partner-cat]');
    var dropBtn = document.getElementById('regency-drop-btn');
    var dropMenu = document.getElementById('regency-drop-menu');
    var dropLabel = document.getElementById('regency-drop-label');
    var regencyOpts = document.querySelectorAll('[data-regency-val]');
    var searchInput = document.getElementById('partner-search-input');
    var resetBtn = document.getElementById('partner-reset-btn');
    var countStatus = document.getElementById('partner-count-status');

    var gridEl = document.getElementById('partner-cards-grid');
    var cards = document.querySelectorAll('.partner-card');
    var emptyBox = document.getElementById('partner-empty-state');

    function applyFilterAndState() {
      if (!gridEl || !emptyBox) return;

      var visibleCount = 0;
      cards.forEach(function (card) {
        var cCat = card.getAttribute('data-category') || '';
        var cLoc = card.getAttribute('data-location') || '';
        var cSearch = card.getAttribute('data-search') || '';

        var matchCat = activeCat === allCatValue || cCat === activeCat;
        var matchReg = true;
        if (activeRegency !== allRegionValue) {
          if (activeRegency === 'Ngawi & Mojokerto') {
            matchReg = cLoc.indexOf('Ngawi') !== -1 || cLoc.indexOf('Mojokerto') !== -1;
          } else if (activeRegency === regionIntlValue) {
            var lowerLoc = cLoc.toLowerCase();
            matchReg = regionIntlTerms.some(function (term) {
              return lowerLoc.indexOf(term) !== -1;
            });
          } else {
            matchReg = cLoc.toLowerCase().indexOf(activeRegency.toLowerCase()) !== -1;
          }
        }
        var matchQuery = !searchQuery || cSearch.indexOf(searchQuery) !== -1;

        if (matchCat && matchReg && matchQuery) {
          card.removeAttribute('hidden');
          visibleCount++;
        } else {
          card.setAttribute('hidden', '');
        }
      });

      if (countStatus) {
        countStatus.textContent = countTemplate.replace('{n}', String(visibleCount));
      }

      if (visibleCount === 0) {
        gridEl.setAttribute('hidden', '');
        emptyBox.removeAttribute('hidden');
      } else {
        emptyBox.setAttribute('hidden', '');
        gridEl.removeAttribute('hidden');
      }
    }

    catBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        activeCat = btn.getAttribute('data-partner-cat') || allCatValue;
        catBtns.forEach(function (b) {
          var isMatch = b.getAttribute('data-partner-cat') === activeCat;
          b.classList.toggle('is-active', isMatch);
          b.setAttribute('aria-pressed', String(isMatch));
        });
        applyFilterAndState();
      });
    });

    if (dropBtn && dropMenu) {
      dropBtn.addEventListener('click', function () {
        var expanded = dropBtn.getAttribute('aria-expanded') === 'true';
        dropBtn.setAttribute('aria-expanded', String(!expanded));
        if (expanded) {
          dropMenu.setAttribute('hidden', '');
        } else {
          dropMenu.removeAttribute('hidden');
        }
      });

      regencyOpts.forEach(function (opt) {
        opt.addEventListener('click', function () {
          activeRegency = opt.getAttribute('data-regency-val') || allRegionValue;
          regencyOpts.forEach(function (o) {
            o.setAttribute('aria-selected', String(o === opt));
          });
          if (dropLabel) dropLabel.textContent = regionPrefix + ' ' + activeRegency;
          dropBtn.setAttribute('aria-expanded', 'false');
          dropMenu.setAttribute('hidden', '');
          applyFilterAndState();
        });
      });

      document.addEventListener('click', function (ev) {
        var wrap = document.getElementById('partner-regency-dropdown');
        if (wrap && !wrap.contains(ev.target)) {
          dropBtn.setAttribute('aria-expanded', 'false');
          dropMenu.setAttribute('hidden', '');
        }
      });

      document.addEventListener('keydown', function (ev) {
        if (ev.key === 'Escape' && dropBtn.getAttribute('aria-expanded') === 'true') {
          dropBtn.setAttribute('aria-expanded', 'false');
          dropMenu.setAttribute('hidden', '');
          dropBtn.focus();
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', function () {
        searchQuery = searchInput.value.trim().toLowerCase();
        applyFilterAndState();
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        activeCat = allCatValue;
        activeRegency = allRegionValue;
        searchQuery = '';
        if (searchInput) searchInput.value = '';
        if (dropLabel) dropLabel.textContent = regionPrefix + ' ' + allRegionValue;
        catBtns.forEach(function (b, idx) {
          b.classList.toggle('is-active', idx === 0);
          b.setAttribute('aria-pressed', String(idx === 0));
        });
        applyFilterAndState();
      });
    }
  })();
</script>
<style>
  .about-hero-band {
    padding: 48px 0;
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: start;
  }

  .about-title {
    margin: 12px 0 20px;
  }

  .about-lead {
    margin-bottom: 24px;
    color: var(--ink);
  }

  .about-prose p {
    margin-bottom: 16px;
  }

  .about-media-frame {
    margin-bottom: 20px;
  }

  .about-hero-img {
    height: 320px;
  }

  .vision-box {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .vision-box h2 {
    margin: 0;
  }

  .mission-list {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .timeline-band,
  .partners-band,
  .facilities-band {
    padding: 48px 0;
  }

  .band-intro {
    max-width: 72ch;
    margin-bottom: 32px;
  }

  .band-intro h2 {
    margin: 8px 0 12px;
  }

  .band-intro p {
    margin: 0;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .timeline-row {
    padding: 28px;
    display: grid;
    grid-template-columns: 200px 1.2fr 0.8fr;
    gap: 28px;
    align-items: start;
  }

  .timeline-year-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .timeline-year {
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.8px;
    color: var(--ink);
  }

  .timeline-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .timeline-body-col h3 {
    margin-bottom: 8px;
  }

  .timeline-body-col p:last-child {
    margin-bottom: 0;
  }

  .timeline-impact-col {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .timeline-impact-col p {
    margin: 0;
    color: var(--ink);
  }

  /* Filter Deck */
  .partner-filter-deck {
    padding: 24px;
    margin-bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .partner-filter-deck .savee-segmented {
    background-color: var(--surface);
  }

  .search-on-surface {
    background-color: var(--canvas);
  }

  .filter-row-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
  }

  .filter-row-bottom {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    align-items: end;
  }

  .partner-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .partner-cards-grid[hidden] {
    display: none;
  }

  .partner-card {
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
  }

  .partner-card[hidden] {
    display: none;
  }

  .partner-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .partner-card h3 {
    margin: 0 0 4px;
  }

  .partner-card p {
    margin: 0;
  }

  .partner-model-block {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .partner-commodities {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .commodity-tag {
    padding: 4px 10px;
    border-radius: var(--rounded-full);
    background-color: var(--canvas);
    color: var(--ink);
  }

  /* Facilities Band */
  .facilities-surface {
    padding: 40px 48px;
    border-radius: var(--rounded-lg);
  }

  .facilities-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 32px;
  }

  .facilities-header h2 {
    margin: 8px 0 0;
  }

  .facilities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .facility-card {
    padding: 24px;
    border-radius: var(--rounded-xs);
    background-color: var(--canvas);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .facility-card h3,
  .facility-card p {
    margin: 0;
  }

  .facility-role {
    color: var(--ink);
    font-weight: 500;
  }

  @media (max-width: 1024px) {
    .about-hero-grid,
    .timeline-row,
    .filter-row-bottom {
      grid-template-columns: 1fr;
    }

    .partner-cards-grid,
    .facilities-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .about-hero-band,
    .timeline-band,
    .partners-band,
    .facilities-band {
      padding: 28px 0;
    }

    .about-hero-grid {
      gap: 24px;
    }

    .about-hero-img {
      height: 220px;
    }

    .vision-box,
    .partner-card,
    .facility-card {
      padding: 18px 16px;
    }

    .band-intro {
      margin-bottom: 20px;
    }

    .timeline-row {
      padding: 18px 16px;
      gap: 14px;
    }

    .timeline-year {
      font-size: 22px;
    }

    .timeline-impact-col {
      padding: 16px;
    }

    .partner-filter-deck {
      padding: 16px;
      gap: 14px;
      margin-bottom: 20px;
    }

    .filter-row-top > *,
    .filter-row-bottom > * {
      width: 100%;
      min-width: 0;
    }

    .partner-filter-deck .savee-segmented {
      background-color: transparent;
      border-radius: 0;
    }

    .partner-filter-deck .savee-segment-btn {
      background-color: var(--canvas);
    }

    .partner-filter-deck .savee-segment-btn.is-active {
      background-color: var(--primary);
      color: var(--accent-fg);
    }

    .partner-cards-grid,
    .facilities-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .facilities-surface {
      padding: 20px 16px;
      border-radius: var(--rounded-xs);
    }

    .facilities-header {
      margin-bottom: 20px;
      gap: 12px;
    }

    .facilities-header .savee-btn {
      width: 100%;
    }
  }
</style>

